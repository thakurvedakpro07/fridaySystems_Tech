# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — files excluded from the Docker build context
#
# Docker sends the entire build context (this directory) to the Docker daemon
# before processing the Dockerfile. Large or irrelevant files slow every build.
# This file keeps the context small and prevents secrets from leaking into layers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── CI/CD ─────────────────────────────────────────────────────────────────────
.github

# ── Documentation ─────────────────────────────────────────────────────────────
docs
*.md
README*
screenshots
prompts
temp

# ── Environment & secrets — NEVER bake these into images ─────────────────────
backend/.env
backend/.env.*
.env
.env.*
*.pem
*.key

# ── Python caches ─────────────────────────────────────────────────────────────
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.Python
backend/venv
backend/.venv

# ── Django local artefacts ────────────────────────────────────────────────────
backend/db.sqlite3
backend/db_temp.sqlite3
backend/staticfiles
backend/mediafiles

# ── Frontend — platform-specific binaries and build output ────────────────────
frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.*

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
.idea
.vscode
*.swp
*.swo
Thumbs.db

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
