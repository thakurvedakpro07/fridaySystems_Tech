# ─────────────────────────────────────────────────────────────────
# SupportMitra — Environment Variables Template
#
# HOW TO USE:
#   cp .env.example .env
#   Then fill in every value marked "replace-with-..."
#   NEVER commit the actual .env file — it contains secrets!
# ─────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────
# A long random string that signs cookies and tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-50-char-random-string

# Set to 1 only during local development. MUST be 0 in production.
DEBUG=1

# Comma-separated list of hostnames Django will accept requests from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Your timezone for display and SLA calculations.
TIME_ZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# When using Docker Compose the host is the service name "db".
DATABASE_URL=postgres://supportmitra:supportmitra@db:5432/supportmitra

# ── Redis ────────────────────────────────────────────────────────
# Used as Celery's task queue and Django's session/cache backend.
REDIS_URL=redis://redis:6379/0

# ── JWT Tokens ───────────────────────────────────────────────────
# How long an access token stays valid (in minutes).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# How long a refresh token stays valid (in days).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Razorpay (Payment Gateway) ────────────────────────────────────
# Get these from your Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── PayU (Alternative Payment Gateway) ───────────────────────────
PAYU_MERCHANT_KEY=xxxxxxxx
PAYU_MERCHANT_SALT=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (SendGrid) ──────────────────────────────────────────────
# Get from SendGrid Dashboard → Settings → API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=support@supportmitra.in

# ── WhatsApp (Gupshup) ────────────────────────────────────────────
GUPSHUP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GUPSHUP_PHONE_NUMBER=+918XXXXXXXXX

# ── Object Storage (DigitalOcean Spaces / AWS S3 compatible) ──────
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_STORAGE_BUCKET_NAME=supportmitra-assets
AWS_S3_ENDPOINT_URL=https://blr1.digitaloceanspaces.com
AWS_S3_REGION_NAME=blr1

# ── GST / Business Details ────────────────────────────────────────
GST_RATE=0.18
BUSINESS_GSTIN=29XXXXXXXXX1Z5
BUSINESS_NAME=SupportMitra Technologies

# ── Sentry (Error Tracking) ───────────────────────────────────────
# Leave blank during local dev; fill in for staging/production.
SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────────
# Toggle features on/off without changing code.
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_AUTO_ASSIGNMENT=false
