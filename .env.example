# ─────────────────────────────────────────────────────────────────────────────
# .env.example — SupportMitra environment variable template
#
# HOW TO USE:
#   cp .env.example backend/.env
#   # Edit backend/.env and fill in every REQUIRED value
#   # backend/.env is gitignored — never commit real secrets
#
# PRODUCTION:
#   Copy to /opt/supportmitra/backend/.env on the VPS, fill in real values,
#   then: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Generate SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────

# REQUIRED — 50+ char random string; signs cookies, JWT tokens, and CSRF tokens
SECRET_KEY=django-insecure-replace-this-with-a-real-50-char-random-key

# 1 = dev (debug pages, console emails, AllowAny API)
# 0 = production (tighter security, IsAuthenticated API, real emails)
DEBUG=1

# Comma-separated hostnames Django will serve.
# "backend" is needed when the Vite dev-proxy sends Host: backend inside Docker.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Your local timezone for display and SLA deadline calculations
TIME_ZONE=Asia/Kolkata

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — without this Django falls back to SQLite (wrong in any Docker context)
# Inside Docker Compose the host is the service name "db"
DATABASE_URL=postgres://supportmitra:supportmitra@db:5432/supportmitra

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED — Celery task queue, Celery result backend, and Django cache
# Inside Docker Compose the host is the service name "redis"
REDIS_URL=redis://redis:6379/0

# ── Payments — Razorpay ───────────────────────────────────────────────────────
# REQUIRED in production
# Dashboard → Settings → API Keys (use rzp_test_ keys for dev)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
# Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ── Email — SendGrid ─────────────────────────────────────────────────────────
# Optional in dev (console backend prints to terminal instead).
# REQUIRED in production for ticket confirmations, password resets, SLA alerts.
# Dashboard → Settings → API Keys → Create
SENDGRID_API_KEY=SG.replace_with_sendgrid_key
DEFAULT_FROM_EMAIL=support@supportmitra.in

# ── WhatsApp — Gupshup ───────────────────────────────────────────────────────
# Optional — set ENABLE_WHATSAPP_NOTIFICATIONS=true to activate
GUPSHUP_API_KEY=replace_with_gupshup_key
GUPSHUP_APP_NAME=SupportMitra
GUPSHUP_PHONE_NUMBER=+918XXXXXXXXX

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_AUTO_ASSIGNMENT=false

# ── JWT token lifetimes ───────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── GST / Business details ────────────────────────────────────────────────────
GST_RATE=0.18
BUSINESS_GSTIN=22AAAAA0000A1Z5
BUSINESS_NAME=SupportMitra Technologies
APP_URL=https://supportmitra.in

# ── File storage — AWS S3 / DigitalOcean Spaces (optional) ───────────────────
# Leave blank to use local disk (default — suitable for a single VPS).
# Fill all four to use S3-compatible object storage for user uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=supportmitra-assets
AWS_S3_ENDPOINT_URL=https://blr1.digitaloceanspaces.com
AWS_S3_REGION_NAME=ap-south-1

# ── Error tracking — Sentry (optional) ───────────────────────────────────────
# Leave blank to disable. Set in production to receive error alerts via email.
# sentry.io → New Project → Django → DSN
SENTRY_DSN=

# ── PayU (alternative payment gateway, not yet active) ───────────────────────
PAYU_MERCHANT_KEY=xxxxxxxx
PAYU_MERCHANT_SALT=xxxxxxxxxxxxxxxxxxxxxxxx
