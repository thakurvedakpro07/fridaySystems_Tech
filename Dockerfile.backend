# ─────────────────────────────────────────────────────────────────
# Dockerfile.backend
#
# Builds the Django application image.
# Uses Python 3.11 on a slim Debian base (small download size).
# ─────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# Prevents Python from writing .pyc bytecode files to disk
ENV PYTHONDONTWRITEBYTECODE=1
# Ensures print() and logging output appear in Docker logs immediately
ENV PYTHONUNBUFFERED=1
# Tells Django which settings module to use — needed by gunicorn, celery,
# and management commands so they all find the same config without any
# extra flags
ENV DJANGO_SETTINGS_MODULE=supportmitra.settings

WORKDIR /app

# Install system packages needed by psycopg2 (PostgreSQL driver)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies first.
# Docker caches this layer — if requirements.txt hasn't changed,
# pip install is skipped on the next build (faster rebuilds).
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the backend source code
COPY backend/ .

# Run as a non-root user — reduces blast radius if a dependency is compromised.
RUN groupadd -r django && useradd -r -g django -d /app -s /sbin/nologin django \
    && chown -R django:django /app
USER django

# Expose the port Gunicorn will listen on
EXPOSE 8000

# Default command: Gunicorn without --reload (production-safe).
# docker-compose.yml overrides this command with --reload for local development.
CMD ["gunicorn", "supportmitra.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
