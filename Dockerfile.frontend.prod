# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.frontend.prod — Multi-stage production build for the React app
#
# Stage 1 (builder): installs Node deps and runs `npm run build` → produces dist/
# Stage 2 (production): copies dist/ into an nginx:alpine image for serving
#
# Usage (fully containerised deploy):
#   docker build -f Dockerfile.frontend.prod -t supportmitra-frontend .
#   docker run -p 80:80 supportmitra-frontend
#
# Usage (host-nginx deploy — build only):
#   docker build --target builder -f Dockerfile.frontend.prod -o dist-out .
#   # dist-out/dist/ contains the compiled assets — copy to VPS
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Node build ───────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy manifests first — layer is cached if neither file changes
COPY frontend/package*.json ./

# Install all deps (including devDependencies — Vite is a devDep)
RUN npm ci

# Copy source
COPY frontend/ .

# VITE_API_BASE_URL — override at build time if the API is on a separate domain.
# Leave empty (default) when Nginx reverse-proxies /api/* from the same origin.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build
# dist/ is now at /app/dist

# ── Stage 2: nginx static server ──────────────────────────────────────────────
# Used when deploying the frontend as its own container (e.g. docker-compose.nginx.yml).
# The host-nginx approach (default) uses the dist/ output from Stage 1 directly.
FROM nginx:1.25-alpine AS production

# Remove nginx's default welcome page
RUN rm -f /usr/share/nginx/html/index.html

# Copy built React app
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA routing + security headers (HSTS, CSP, X-Frame-Options, etc. — kept in
# sync with nginx/nginx.conf, the primary deployment's nginx config) — see
# nginx/frontend-standalone.conf for the full server block.
COPY nginx/frontend-standalone.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
