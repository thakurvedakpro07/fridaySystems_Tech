# ─────────────────────────────────────────────────────────────────────────────
# SupportMitra — Backend Environment Variables
#
# SETUP:
#   cp backend/.env.example backend/.env
#   Fill in every value marked REQUIRED before running in production.
#   Then: docker compose up --build
#
# NEVER commit backend/.env to git. It is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────

# REQUIRED — Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Must be 50+ chars, unique per environment, never reused across staging/prod.
SECRET_KEY=change-me-to-a-50-plus-char-random-string

# Set to 1 ONLY for local development. NEVER set to 1 in production.
# When DEBUG=0, Django checks ALLOWED_HOSTS and enables all security headers.
DEBUG=1

# Comma-separated list of domains Django will serve (no spaces).
# Production example: ALLOWED_HOSTS=supportmitra.in,www.supportmitra.in
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────

# REQUIRED in production (startup raises ImproperlyConfigured if missing and DEBUG=0).
# Local Docker default (matches docker-compose.yml):
DATABASE_URL=postgres://supportmitra:supportmitra@db:5432/supportmitra

# Production example (use a strong random password — never use "supportmitra"):
# DATABASE_URL=postgres://user:STRONG_PASSWORD@your-db-host:5432/supportmitra_prod

# ── Redis ─────────────────────────────────────────────────────────────────────

# Local Docker default:
REDIS_URL=redis://redis:6379/0

# Production example (add a Redis password):
# REDIS_URL=redis://:STRONG_REDIS_PASSWORD@your-redis-host:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
# Only used in production (DEBUG=0). Development prints emails to the terminal.

EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=support@supportmitra.in

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# REQUIRED in production — startup raises ImproperlyConfigured if missing when DEBUG=0.
# Use test (rzp_test_*) keys for development, live (rzp_live_*) keys for production.

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── File Storage (AWS S3) ─────────────────────────────────────────────────────
# Needed for the file/screenshot upload feature.
# In production, prefer IAM instance roles over explicit keys (leave blank).

AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=supportmitra-uploads
AWS_S3_REGION_NAME=ap-south-1

# ── Business / Tax ────────────────────────────────────────────────────────────
GST_RATE=0.18
BUSINESS_GSTIN=
BUSINESS_NAME=SupportMitra Technologies

# ── Application URL ───────────────────────────────────────────────────────────
# REQUIRED in production — used to build links in transactional emails.
# Must be your live domain (no trailing slash).
# Development default: http://localhost:5173 (Vite dev server)
APP_URL=https://supportmitra.in

# ── JWT Token Lifetimes ───────────────────────────────────────────────────────
# Access token: short-lived (15 min default). Reduce in high-security environments.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_AUTO_ASSIGNMENT=false

# ── Timezone ─────────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata

# ── Error Monitoring (Sentry) ─────────────────────────────────────────────────
# Leave blank in development. Set DSN from your Sentry project for production.
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# ── PRODUCTION GO-LIVE CHECKLIST ─────────────────────────────────────────────
#
#   [ ] SECRET_KEY is 50+ chars, unique, never committed to git
#   [ ] DEBUG=0
#   [ ] ALLOWED_HOSTS contains only your real domain(s)
#   [ ] DATABASE_URL uses a strong unique password (not "supportmitra")
#   [ ] REDIS_URL includes a password
#   [ ] RAZORPAY_* keys are live (rzp_live_*) keys
#   [ ] EMAIL_HOST_PASSWORD is set
#   [ ] SENTRY_DSN is set for production error visibility
#   [ ] AWS keys are IAM-scoped to read/write only the uploads bucket
#   [ ] docker-compose does NOT expose ports 5432 or 6379 publicly
#
