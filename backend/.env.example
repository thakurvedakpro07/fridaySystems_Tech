# ─────────────────────────────────────────────────────────────────────────────
# SupportMitra — Backend Environment Variables
#
# SETUP:
#   cp backend/.env.example backend/.env
#   Fill in the values below, then run:
#   docker compose up --build
#
# NEVER commit .env to git. It is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-50-plus-char-random-string

# Set to 1 only for local development. NEVER set to 1 in production.
DEBUG=1

# Comma-separated list of domains that Django will serve.
# Production example: ALLOWED_HOSTS=supportmitra.in,www.supportmitra.in
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker setup (matches docker-compose.yml defaults):
DATABASE_URL=postgres://supportmitra:supportmitra@db:5432/supportmitra

# Production example (replace with your real credentials):
# DATABASE_URL=postgres://user:password@your-db-host:5432/supportmitra

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker setup:
REDIS_URL=redis://redis:6379/0

# Production example:
# REDIS_URL=redis://:your-redis-password@your-redis-host:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
# SMTP settings (used in production when DEBUG=0)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=support@supportmitra.in

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── File Storage (AWS S3) ─────────────────────────────────────────────────────
# Needed for file/screenshot upload feature (Phase 10+)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=supportmitra-uploads
AWS_S3_REGION_NAME=ap-south-1

# ── Business / Tax ────────────────────────────────────────────────────────────
GST_RATE=0.18
BUSINESS_GSTIN=
BUSINESS_NAME=SupportMitra Technologies

# ── JWT Token Lifetimes ───────────────────────────────────────────────────────
# Access token expires in N minutes (default: 15)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# Refresh token expires in N days (default: 7)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_AUTO_ASSIGNMENT=false

# ── Timezone ─────────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata
